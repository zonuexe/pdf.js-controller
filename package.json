{
  "name": "@zonuexe/pdf.js-controller",
  "version": "2.0.0",
  "description": "provide controller and text layer for pdf.js",
  "keywords": [
    "pdf",
    "pdf.js",
    "presentation",
    "selection",
    "slide",
    "text"
  ],
  "homepage": "https://github.com/zonuexe/pdf.js-controller",
  "bugs": {
    "url": "https://github.com/zonuexe/pdf.js-controller/issues"
  },
  "license": "MIT",
  "author": "azu",
  "maintainers": [
    {
      "name": "zonuexe",
      "email": "tadsan@zonu.me",
      "url": "https://github.com/zonuexe"
    }
  ],
  "contributors": [
    {
      "name": "azu"
    },
    {
      "name": "zonuexe"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonuexe/pdf.js-controller.git"
  },
  "files": [
    "css",
    "dist/PDFJSController.mjs",
    "dist/PDFJSController.mjs.map",
    "dist/PDFJSController.d.mts"
  ],
  "type": "module",
  "main": "./dist/PDFJSController.mjs",
  "types": "./dist/PDFJSController.d.mts",
  "exports": {
    ".": {
      "types": "./dist/PDFJSController.d.mts",
      "import": "./dist/PDFJSController.mjs"
    },
    "./css/pdf-slide.css": {
      "types": "./css/pdf-slide.css.d.ts",
      "default": "./css/pdf-slide.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp dev",
    "start": "vp dev",
    "watch": "vp pack --watch",
    "test": "vp test",
    "prepack": "vp pack"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@10.33.2"
}
